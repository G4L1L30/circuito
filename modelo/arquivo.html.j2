<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Circuito · Edições anteriores</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Oswald:wght@500;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&family=VT323&display=swap">
<style>
{{ css }}
</style>
</head>
<body>
<main class="mesa">
  <div class="mesa-topo">
    <span><strong>Circuito</strong> · edições anteriores</span>
    <span><a href="index.html">Edição de hoje</a></span>
  </div>
  <ol class="arquivo">
    {% for e in edicoes %}
    <li><b>{{ '%03d' % e.numero }}</b><a href="edicoes/{{ e.data }}.html">{{ e.manchete }}</a><span>{{ e.data_extenso }} · {{ e.paginas }} páginas</span></li>
    {% endfor %}
  </ol>
</main>
</body>
</html>
