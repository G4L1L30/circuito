{#- Prévia de link: é isso que o WhatsApp e as redes leem para montar o cartão. URLs precisam ser absolutas. -#}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Circuito">
<meta property="og:locale" content="pt_BR">
<meta property="og:url" content="{{ previa.url }}">
<meta property="og:title" content="{{ previa.titulo }}">
<meta property="og:description" content="{{ previa.descricao }}">
<meta property="og:image" content="{{ previa.imagem }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Circuito: revista diária de tecnologia em 5 minutos, com um computador antigo na capa">
<meta name="twitter:card" content="summary_large_image">
